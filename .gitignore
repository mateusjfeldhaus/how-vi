# ============================================================
# uc-preciso : .gitignore raiz (cobre backend e frontend)
# ============================================================

# Dependências (npm/yarn/pnpm)
node_modules/
**/node_modules/
.pnp
.pnp.js

# Variáveis de ambiente (NUNCA versionar credenciais)
.env
.env.*
!.env.example

# Builds
dist/
dist-ssr/
build/
.vite/
.next/
out/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache
.cache/
.parcel-cache/
.eslintcache

# Testes / cobertura
coverage/
.nyc_output/

# Editores / IDEs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos locais temporários
*.local
*.tmp
*.bak
